# Copy to .env and adjust as needed:  cp .env.example .env
#
# Local-first: the scraper and RAG stack need no cloud API keys.
# RAG uses Ollama on your machine (see config.py + rag/indexer.py).
# Ensure `ollama serve` is running and models are pulled:
#   ollama pull llama3.2         # generation
#   ollama pull nomic-embed-text # embeddings
#   ollama pull qwen2.5:3b       # graph extraction (GraphRAG layer)

# Optional hosted providers (unused in local mode)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Graph extraction model (override the default qwen2.5:3b if desired)
# GRAPH_LLM_MODEL=qwen2.5:3b

# ── Neo4j (graph store for the GraphRAG layer) ───────────────────────────────
# Consumed by docker-compose.yml (NEO4J_AUTH) and config.py (Python driver).
# Use a strong password for anything beyond local dev.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=enisa-graph-dev
NEO4J_DATABASE=neo4j

# ── MongoDB Atlas (cloud vector store, third retrieval backend) ──────────────
# Optional. Leave MONGODB_URI empty and the Atlas backend stays off; the local
# vector store and the graph are unaffected.
#
# Get the connection string from Atlas: Clusters → Connect → Drivers → Python.
# Replace <password> with your database user's password and URL-encode any
# special characters in it (@ : / ? # [ ] must be percent-encoded).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=enisa_rag
MONGODB_COLLECTION=chunks
MONGODB_VECTOR_INDEX=vector_index
